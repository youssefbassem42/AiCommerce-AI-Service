# === AI Provider Keys ===
# At least ONE is required for the service to start.
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# === Default Model Configuration ===
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
REQUEST_TIMEOUT=120

# === JWT Authentication ===
# Shared HS256 secret MUST match the .NET backend's Jwt:SecretKey (>= 32 chars).
# Generate one with: openssl rand -hex 32
# JWT_SECRET_KEY is accepted as a fallback for backward compatibility.
JWT_SECRET=generate-a-random-64-char-hex-secret-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256

# === MongoDB ===
MONGO_URI=mongodb://localhost:27017
MONGO_DB=ai_commerce

# === Qdrant Vector Store ===
QDRANT_URL=http://localhost:6333

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Security ===
ENCRYPTION_KEY=

# === RAG Configuration (optional) ===
RAG_LLM_PROVIDER=gemini
RAG_LLM_MODEL=gemini-2.5-flash
RAG_EMBEDDING_MODEL=gemini-embedding-001
