# === AI Provider Keys ===
# At least ONE is required for the service to start.
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# === Default Model Configuration ===
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
REQUEST_TIMEOUT=120

# === JWT Authentication ===
JWT_SECRET_KEY=change-me-to-a-secure-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256

# === MongoDB ===
MONGO_URI=mongodb://localhost:27017
MONGO_DB=ai_commerce

# === Qdrant Vector Store ===
QDRANT_URL=http://localhost:6333

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Security ===
ENCRYPTION_KEY=

# === RAG Configuration (optional) ===
RAG_LLM_PROVIDER=gemini
RAG_LLM_MODEL=gemini-2.5-flash
RAG_EMBEDDING_MODEL=gemini-embedding-001
